# Flask security
SESSION_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-different-long-random-secret

# SMTP / Gmail App Password configuration
# For Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
MAIL_FROM=your-gmail-address@gmail.com

# Optional demo-account email addresses
DEMO_ADMIN_EMAIL=
DEMO_MANAGER_EMAIL=
DEMO_GUEST_EMAIL=
